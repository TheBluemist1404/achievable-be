{
  "name": "express-be-template",
  "version": "1.0.0",
  "main": "dist/server.js",
  "repository": "git@github.com:TheBluemist1404/achievable-be.git",
  "author": "TheBluemist1404 <hoang.ct1lhp@gmail.com>",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=20.0.0 <25.0.0"
  },
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec \"ts-node -r tsconfig-paths/register src/server.ts\"",
    "migrate:tags": "ts-node -r tsconfig-paths/register src/scripts/migrate-tags.ts",
    "typecheck": "tsc --noEmit --incremental false",
    "build": "tsc && tsc-alias",
    "verify:build": "node scripts/verify-build.cjs",
    "ci": "yarn typecheck && yarn build && yarn verify:build",
    "start": "node dist/server.js"
  },
  "license": "MIT",
  "dependencies": {
    "@types/cors": "^2.8.19",
    "@types/jsonwebtoken": "^9.0.10",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.18.2",
    "redis": "^6.2.0",
    "tsconfig-paths": "^4.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.3",
    "@types/node": "^24.5.2",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.1",
    "typescript": "^5.9.2"
  }
}
